---
interface Props {
  attributes?: Record<string, string>;
  classes: string[];
}
import { langOf, t } from "../i18n/index.js";
const { attributes = {}, classes } = Astro.props;
const L = t(langOf(Astro.url.pathname));
---

<div style="overflow-x:auto"><table class="site-props">
  <thead><tr><th>{L.propsHead}</th><th>{L.propsDesc}</th></tr></thead>
  <tbody>
    {Object.entries(attributes).map(([k, v]) => (<tr><td>{k}</td><td>{v}</td></tr>))}
    <tr><td>{L.classes}</td><td class="xxd-text" data-variant="mono-secondary">{classes.join("  ")}</td></tr>
  </tbody>
</table></div>
