        "计划行变化时旧字上滚出、新字上滚进；减少动效时直接换"
      ]
    },
    {
      "name": "StatusLine",
      "slug": "status-line",
      "zh": "状态行",
      "from": "图片排序、长文发布",
      "summary": "dock 上方的一行：空着，除非有事要说 —— 一句话，最多一个动作。",
      "classes": [
        "xxd-statusline"
      ],
      "markup": "<div class=\"xxd-frame\" style=\"max-width:420px\">\n  <div class=\"xxd-statusline\" id=\"status-demo\" hidden></div>\n  <footer class=\"xxd-dock\" style=\"position:static\"><div class=\"xxd-dock__status\">24 张 · 来自 mp.weixin.qq.com</div><div class=\"xxd-dock__primary\"><button class=\"xxd-btn\" data-variant=\"primary\" data-size=\"sm\">复制 24 个链接</button></div></footer>\n</div>\n<div class=\"xxd-cluster\" style=\"margin-top:12px\">\n  <button class=\"xxd-btn\" data-size=\"sm\" onclick=\"Xxd.setStatus(document.getElementById('status-demo'), '正在读取颜色 12 / 40', { action: { label: '停止' } })\">进行中</button>\n  <button class=\"xxd-btn\" data-size=\"sm\" onclick=\"Xxd.setStatus(document.getElementById('status-demo'), '今天的 5 组颜色排序用完了（原样和倒过来不受限制）', { tone: 'warning', action: { label: '开通会员' } })\">用完了</button>\n  <button class=\"xxd-btn\" data-size=\"sm\" onclick=\"Xxd.setStatus(document.getElementById('status-demo'), '')\">清空</button>\n</div>",
      "rules": [
        "一句话，最多一个动作；没事就整行消失",
        "不用弹窗、不用系统通知"
      ],
      "js": "Xxd.setStatus(el, text, { tone: \"warning\", action: { label, onClick } })"
    },
    {
      "name": "ProgressPill",
      "slug": "progress-pill",
      "zh": "写入进度胶囊",
      "from": "长文发布",
      "summary": "在别人的网页上（X 编辑器）写入时，一个细细的深色胶囊：转圈 · 进度 · 数字。放在 Shadow DOM 里。",
      "classes": [
        "xxd-progress-pill"
      ],
      "markup": "<div class=\"xxd-progress-pill\"><span class=\"xxd-spinner\" aria-hidden=\"true\"></span>正在写入<progress class=\"xxd-progress\" value=\"62\" max=\"100\"></progress>62%</div>",
      "rules": [
        "用 XxdExtension.mountXxdUI 放进 Shadow DOM，不碰宿主页面",
        "完成后变成一个勾再淡出"
      ]
    },
    {
      "name": "Celebrate",
      "slug": "celebrate",
      "zh": "庆祝",
      "from": "长文发布",
      "summary": "会员开通、第一次写入这类时刻：画一个圈打勾、字依次升起、彩纸从勾那里散开；减少动效时直接给最终状态。",
      "classes": [
        "xxd-celebrate",
        "xxd-celebrate__ring",
        "xxd-confetti"
      ],
      "markup": "<div class=\"xxd-celebrate\" id=\"cele\">\n  <svg class=\"xxd-celebrate__ring\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"miter\"><circle cx=\"12\" cy=\"12\" r=\"9.5\" pathLength=\"1\"/><path d=\"m7.5 12 3 3 6-6\" pathLength=\"1\"/></svg>\n  <p class=\"xxd-text\" data-variant=\"heading2\">会员已开通</p>\n  <p class=\"xxd-text\" data-variant=\"caption\">有效期至 2027年11月8日</p>\n  <button class=\"xxd-btn\" data-variant=\"primary\" onclick=\"Xxd.celebrate(this.closest('.xxd-celebrate').querySelector('svg'))\">开始写作</button>\n</div>",
      "rules": [
        "只在真正值得的时刻；一次",
        "只动 opacity / transform；减少动效时不放彩纸"
      ],
      "js": "Xxd.celebrate(anchorElement)"
    },
    {
      "name": "SettingsSearch",
      "slug": "settings-search",
      "zh": "设置搜索",
      "from": "长文发布",
      "summary": "搜索框钉在设置页顶部（⌘F 跳过来，Esc 清空）：过滤到匹配的行并标出字；每行带几个别人可能搜的词（暗色 / dark / 夜间 都能找到主题）。",
      "classes": [],
      "markup": "<div style=\"max-width:440px\">\n  <div class=\"xxd-input-wrap\" style=\"margin-bottom:16px\"><i data-xxd-icon=\"Search\" data-size=\"16\"></i><input class=\"xxd-input\" type=\"search\" id=\"ss-input\" placeholder=\"搜索设置（⌘F）\" aria-label=\"搜索设置\"><button class=\"xxd-input-clear\" aria-label=\"清空\"><i data-xxd-icon=\"X\" data-size=\"14\"></i></button></div>\n  <div class=\"xxd-settings\" id=\"ss-box\">\n    <section class=\"xxd-group\"><h2 class=\"xxd-group__title\">外观</h2><div class=\"xxd-group__body\">\n      <div class=\"xxd-row\" data-keywords=\"暗色 dark 夜间 主题\"><div class=\"xxd-row__text\"><div class=\"xxd-row__title\">主题</div><div class=\"xxd-row__desc\">亮 · 暗 · 跟随系统</div></div></div>\n      <div class=\"xxd-row\" data-keywords=\"圆角 rounded 直角\"><div class=\"xxd-row__text\"><div class=\"xxd-row__title\">圆角</div></div><div class=\"xxd-row__control\"><input type=\"checkbox\" role=\"switch\" class=\"xxd-switch\" aria-label=\"圆角\"></div></div>\n    </div></section>\n    <section class=\"xxd-group\"><h2 class=\"xxd-group__title\">写入</h2><div class=\"xxd-group__body\">\n      <div class=\"xxd-row\" data-keywords=\"标点 引号 punctuation\"><div class=\"xxd-row__text\"><div class=\"xxd-row__title\">智能标点</div></div><div class=\"xxd-row__control\"><input type=\"checkbox\" role=\"switch\" class=\"xxd-switch\" checked aria-label=\"智能标点\"></div></div>\n    </div></section>\n  </div>\n</div>\n<script>Xxd.bindSettingsSearch(document.getElementById(\"ss-input\"), document.getElementById(\"ss-box\"), { hotkey: false });</script>",
      "rules": [
        "没有匹配的行和整组藏起来",
        "放在别处的设置也作为捷径出现在结果里"
      ],
      "js": "Xxd.bindSettingsSearch(input, settingsContainer)"
    },
    {
      "name": "AccountCard",
      "slug": "account-card",
      "zh": "账号卡",
      "from": "各插件",
      "summary": "头像（会员有一圈主色环）· 名字 · 计划行 · 一个动作。",
      "classes": [],
      "markup": "<div class=\"xxd-group__body\" style=\"max-width:380px\"><div class=\"xxd-account\"><span class=\"xxd-avatar\" style=\"--avatar-size:36px\">东</span><div class=\"xxd-account__main\"><div class=\"xxd-account__name\">小小东</div><div class=\"xxd-plan-line\">免费版 · 今天还能写入 3 篇</div></div><button class=\"xxd-btn\" data-size=\"sm\">开通会员</button></div>\n<div class=\"xxd-account\"><span class=\"xxd-avatar\" data-member style=\"--avatar-size:36px\">东</span><div class=\"xxd-account__main\"><div class=\"xxd-account__name\">小小东</div><div class=\"xxd-plan-line\" data-tone=\"warning\">会员 · 还剩 3 天到期</div></div><button class=\"xxd-btn\" data-size=\"sm\">续费</button></div></div>",
      "rules": [
        "数字只在有用时出现：会员看不到次数",
        "最后一周用警告色"
      ]
    },
    {
      "name": "RollText",
      "slug": "roll-text",
      "zh": "字的滚动替换",
      "from": "长文发布",
      "summary": "计划行、计数变化时：旧的字往上滚出、新的往上滚进，一道光扫过（这里只做滚动）。",
      "classes": [
        "xxd-roll"
      ],
      "markup": "<p class=\"xxd-plan-line\"><span id=\"roll-demo\">免费版 · 今天还能写入 3 篇</span></p>\n<button class=\"xxd-btn\" data-size=\"sm\" onclick=\"const el=document.getElementById('roll-demo'); Xxd.rollText(el, el.textContent.includes('免费') ? '会员 · 到 2027年11月8日' : '免费版 · 今天还能写入 3 篇')\">换一下</button>",
      "rules": [
        "减少动效时直接换字"
      ],
      "js": "Xxd.rollText(element, newText)"
    },
    {
      "name": "Permission",
      "slug": "permission",
      "zh": "需要权限",
      "from": "插件（MV3）",
      "summary": "功能要用到一项可选权限时：先说清楚为什么要，按钮在用户点击时才申请；允许了按钮变成「已允许」，拒绝了说明少了什么、怎么再开。不在安装时就把权限全要走。",
      "classes": [],
      "markup": "<div class=\"xxd-banner\" data-tone=\"info\">\n  <div><p class=\"xxd-banner__title\">要读取当前标签页的地址</p><p class=\"xxd-banner__text\">用来把这一页加进清单；只在你点按钮时读，不会记录浏览历史。</p><p class=\"xxd-banner__text\" role=\"status\" id=\"perm-status\"></p></div>\n  <div class=\"xxd-banner__actions\"><button class=\"xxd-btn\" data-size=\"sm\" data-variant=\"primary\" id=\"perm-btn\">允许读取</button></div>\n</div>\n<script>XxdExtension.bindPermission(document.getElementById(\"perm-btn\"), { permissions: [\"tabs\"], status: document.getElementById(\"perm-status\") });</script>",
      "rules": [
        "manifest 里把它写进 optional_permissions / optional_host_permissions，而不是 permissions",
        "chrome.permissions.request 只能在用户点击里调用",
        "说清楚为什么要、只在什么时候用；拒绝之后不反复弹"
      ],
      "a11y": [
        "结果写进 role=\"status\" 的那一行，读屏会念出来",
        "允许之后按钮禁用并标 aria-pressed=\"true\""
      ],
      "js": "await XxdExtension.bindPermission(button, { permissions: [\"tabs\"], origins: [\"https://*.example.com/*\"], status, onChange: (granted) => … })"
    },
    {
      "name": "Shortcuts",
      "slug": "shortcuts",
      "zh": "快捷键",
      "from": "插件（MV3）",
      "summary": "设置页里列出插件的快捷键（manifest 的 commands），没设的写「没设置」；快捷键只能在 Chrome 的快捷键页改，所以最后一个按钮直接打开那一页。",
      "classes": [],
      "markup": "<section class=\"xxd-group\" style=\"width:100%\">\n  <h2 class=\"xxd-group__title\">快捷键</h2>\n  <div class=\"xxd-group__body\" id=\"shortcuts\"></div>\n</section>\n<script>XxdExtension.mountShortcuts(document.getElementById(\"shortcuts\"), { names: { _execute_action: \"打开侧边栏\", save: \"保存当前页\" } });</script>",
      "rules": [
        "用 chrome.commands.getAll() 读当前的快捷键，不要在界面里写死",
        "按键用 xxd-kbd 显示，组合键之间是「+」"
      ],
      "a11y": [
        "每一行的名字是正文，快捷键在右边；没设置时写字，不留空"
      ],
      "js": "await XxdExtension.mountShortcuts(container, { names: { _execute_action: \"打开侧边栏\" } })"
    },
    {
      "name": "ImportExport",
      "slug": "import-export",
      "zh": "导入导出设置",
      "from": "插件（MV3）",
      "summary": "换电脑、重装插件时把设置带走：导出成一个 JSON 文件，导入时只收认得的格式和键，结果用 toast 说一声。",
      "classes": [],
      "markup": "<div class=\"xxd-row\" style=\"width:100%\">\n  <div class=\"xxd-row__text\"><div class=\"xxd-row__title\">设置备份</div><div class=\"xxd-row__desc\">导出成文件，换电脑后导入</div></div>\n  <div class=\"xxd-row__control xxd-cluster\"><button class=\"xxd-btn\" data-size=\"sm\" id=\"export-btn\">导出</button><button class=\"xxd-btn\" data-size=\"sm\" id=\"import-btn\">导入…</button></div>\n</div>\n<script>\n  document.getElementById(\"export-btn\").addEventListener(\"click\", () => XxdExtension.exportSettings({ filename: \"today-settings.json\" }));\n  document.getElementById(\"import-btn\").addEventListener(\"click\", () => {\n    const input = Object.assign(document.createElement(\"input\"), { type: \"file\", accept: \"application/json\" });\n    input.addEventListener(\"change\", () => input.files[0] && XxdExtension.importSettings(input.files[0]));\n    input.click();\n  });\n</script>",
      "rules": [
        "只导入 format 是 xxd-settings 的文件；传 keys 只收认得的键",
        "导入以后各页面通过 chrome.storage.onChanged 自己更新，不要求重开"
      ],
      "a11y": [
        "结果用 toast 说（读屏会念）"
      ],
      "js": "await XxdExtension.exportSettings({ keys: [\"today-ui\", \"today-rules\"], filename: \"today-settings.json\" })\nawait XxdExtension.importSettings(file, { keys: [\"today-ui\", \"today-rules\"] })"
    },
    {
      "name": "WhatsNew",
      "slug": "whats-new",
      "zh": "更新说明",
      "from": "插件（MV3）",
      "summary": "更新到新版本后第一次打开时，在最上面放一条横幅，用两三句话说新版本有什么不同；点「知道了」以后这个版本不再出现。不弹窗、不开新标签页。",
      "classes": [],
      "markup": "<div id=\"whats-new\" style=\"width:100%\"></div>\n<script>XxdExtension.showWhatsNew(document.getElementById(\"whats-new\"), { version: \"1.3.\" + Date.now(), title: \"1.3 更新了这些\", notes: [\"记录可以按天折叠\", \"导出的文件带上了标题\"] });</script>",
      "rules": [
        "只写用户能感觉到的变化，最多三条",
        "版本号缺省取 manifest 的 version；记在 chrome.storage.local"
      ],
      "a11y": [
        "横幅是 role=\"status\"，出现时读屏念一次"
      ],
      "js": "await XxdExtension.showWhatsNew(container, { title: \"1.3 更新了这些\", notes: [\"…\", \"…\"] })"
    },
    {
      "name": "Reload",
      "slug": "reload",
      "zh": "插件已更新，请刷新",
      "from": "插件（MV3）",
      "summary": "内容脚本里：插件被更新或重新加载以后，网页里还留着的旧脚本调用 chrome.* 会报「Extension context invalidated」。用 guardContext 包一层，失效时在自己的 Shadow 里说一声并给一个刷新按钮，而不是悄悄坏掉。",
      "classes": [],
      "markup": "<div class=\"xxd-stack\" id=\"reload-demo\" style=\"width:100%\"><button class=\"xxd-btn\" id=\"reload-try\">保存（模拟插件已更新）</button></div>\n<script>\n  const safe = XxdExtension.guardContext(document.getElementById(\"reload-demo\"));\n  document.getElementById(\"reload-try\").addEventListener(\"click\", () => safe(() => { throw new Error(\"Extension context invalidated.\"); }));\n</script>",
      "rules": [
        "所有 chrome.* 调用（sendMessage、storage）都走 safe(…)",
        "失效以后不要再重试；只给「刷新页面」一个出路"
      ],
      "a11y": [
        "横幅是 role=\"alert\"，焦点移到刷新按钮上"
      ],
      "js": "const safe = XxdExtension.guardContext(ui.root);\nbutton.onclick = () => safe(() => chrome.runtime.sendMessage({ type: \"save\" }));"
    }
  ]
