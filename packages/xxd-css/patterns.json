{
  "$comment": "小小东模式（O4）：展示站 /patterns/* 和注册表测试都读它。",
  "patterns": [
    {
      "name": "DropZone",
      "slug": "drop-zone",
      "zh": "拖放区与拖入遮罩",
      "from": "图片排序",
      "summary": "空的时候是一块虚线区：把东西拖进来、或选择文件、或粘贴；有内容之后，拖到面板任何地方都会出现「松手，放进来」。",
      "classes": [
        "xxd-dropzone",
        "xxd-dropzone__title",
        "xxd-dropveil"
      ],
      "markup": "<div id=\"drop-demo\" class=\"xxd-frame\" data-surface=\"page\" style=\"position:relative;padding:16px;min-height:220px\">\n  <div class=\"xxd-dropzone\" id=\"drop-zone\">\n    <i data-xxd-icon=\"ImagePlus\" data-size=\"24\"></i>\n    <p class=\"xxd-dropzone__title\">把图片拖到这里</p>\n    <p class=\"xxd-help\">也可以 <button class=\"xxd-link\" type=\"button\">选择图片文件</button>，或直接粘贴链接 ⌘V</p>\n  </div>\n  <p class=\"xxd-help\" id=\"drop-out\" style=\"margin-top:12px\"></p>\n</div>\n<script>\n  Xxd.bindDrop(document.getElementById(\"drop-demo\"), {\n    zone: document.getElementById(\"drop-zone\"),\n    onFiles: (files) => (document.getElementById(\"drop-out\").textContent = `收到 ${files.length} 个文件`),\n    onText: (text) => (document.getElementById(\"drop-out\").textContent = `收到文字：${text.slice(0, 40)}`),\n  });\n</script>",
      "anatomy": [
        "虚线区：图标 · 一句话 · 其他方式（选择文件 / 粘贴）",
        "遮罩：盖住整个面板，一句话，拖出去就消失"
      ],
      "rules": [
        "每种进来的方式在点之前就说清会带来什么",
        "粘贴在输入框里时不接管"
      ],
      "js": "const off = Xxd.bindDrop(panel, { zone, onFiles(files) {…}, onText(text) {…}, veil: \"松手，加到这一组\" })"
    },
    {
      "name": "Viewer",
      "slug": "viewer",
      "zh": "图片查看器",
      "from": "图片排序、会员站",
      "summary": "点开大图，← → 翻，Esc 回到同一张；底部一个深色胶囊放操作。",
      "classes": [
        "xxd-viewer",
        "xxd-viewer__bar",
        "xxd-viewer__stage",
        "xxd-viewer__nav",
        "xxd-pill"
      ],
      "markup": "<div class=\"xxd-cluster\" id=\"viewer-demo\">\n  <button class=\"xxd-btn\" data-i=\"0\">打开第 1 张</button><button class=\"xxd-btn\" data-i=\"2\">打开第 3 张</button>\n</div>\n<script>\n  const pics = [\"#d65f32\", \"#3b74b8\", \"#5a8a3c\", \"#7b61b0\"].map((c, i) => ({ src: `data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' width='800' height='560'><rect width='800' height='560' fill='${c}'/><text x='400' y='300' font-size='64' fill='white' text-anchor='middle' font-family='sans-serif'>${i + 1}</text></svg>`)}`, alt: `第 ${i + 1} 张` }));\n  document.getElementById(\"viewer-demo\").addEventListener(\"click\", (e) => {\n    const b = e.target.closest(\"[data-i]\");\n    if (b) Xxd.openViewer(pics, Number(b.dataset.i), { actions: [{ label: \"复制图片\", run: () => Xxd.toast(\"已复制图片\", { tone: \"success\" }) }, { label: \"下载\", run: () => Xxd.toast(\"开始下载\") }] });\n  });\n</script>",
      "rules": [
        "关闭后焦点回到打开它的那个缩略图",
        "操作胶囊：深色半透明，像 X 自己的图片控件"
      ],
      "js": "Xxd.openViewer(items, startIndex, { actions: [{ label, icon, run(item, i) }] })"
    },
    {
      "name": "Sortable",
      "slug": "sortable",
      "zh": "拖拽排序",
      "from": "会员站导航排序、图片排序",
      "summary": "拖把手排序，其余项滑到新位置（FLIP）。触屏长按；键盘：把手上按空格拿起，↑ ↓ 移动，空格放下，Esc 取消。",
      "classes": [
        "xxd-sortable",
        "xxd-sort-handle"
      ],
      "markup": "<ul class=\"xxd-list xxd-group__body xxd-sortable\" data-xxd-sortable style=\"width:100%;max-width:300px\" id=\"sort-demo\">\n  <li class=\"xxd-list__item\" data-sort-item data-id=\"write\"><button class=\"xxd-sort-handle\" aria-label=\"拖动排序：写作\" aria-pressed=\"false\"><i data-xxd-icon=\"GripVertical\" data-size=\"16\"></i></button>写作</li>\n  <li class=\"xxd-list__item\" data-sort-item data-id=\"prompts\"><button class=\"xxd-sort-handle\" aria-label=\"拖动排序：提示词\" aria-pressed=\"false\"><i data-xxd-icon=\"GripVertical\" data-size=\"16\"></i></button>提示词</li>\n  <li class=\"xxd-list__item\" data-sort-item data-id=\"history\"><button class=\"xxd-sort-handle\" aria-label=\"拖动排序：记录\" aria-pressed=\"false\"><i data-xxd-icon=\"GripVertical\" data-size=\"16\"></i></button>记录</li>\n  <li class=\"xxd-list__item\" data-sort-item data-id=\"settings\"><button class=\"xxd-sort-handle\" aria-label=\"拖动排序：设置\" aria-pressed=\"false\"><i data-xxd-icon=\"GripVertical\" data-size=\"16\"></i></button>设置</li>\n</ul>\n<p class=\"xxd-help\" id=\"sort-out\"></p>\n<script>document.getElementById(\"sort-demo\").addEventListener(\"xxd:change\", (e) => (document.getElementById(\"sort-out\").textContent = \"新顺序：\" + e.detail.order.join(\" · \")));</script>",
      "rules": [
        "动画只动 transform（FLIP），减少动效时直接到位",
        "所有排序都能不用拖拽完成（键盘）"
      ],
      "js": "list.addEventListener(\"xxd:change\", (e) => e.detail.order)\nawait Xxd.flip(container, () => reorderDom())  // 通用的「滑到新位置」"
    },
    {
      "name": "History",
      "slug": "history",
      "zh": "按天分组的记录",
      "from": "长文发布、图片排序",
      "summary": "「今天 / 昨天 / 9月12日」小标题下一行一条：缩略图叠放、标题、方式 · 时间；hover 出删除（点两次确认）。",
      "classes": [
        "xxd-history",
        "xxd-history__day",
        "xxd-thumbs"
      ],
      "markup": "<div class=\"xxd-history\" style=\"max-width:420px\">\n  <section><h3 class=\"xxd-history__day\">今天</h3>\n    <ul class=\"xxd-list xxd-group__body\" data-interactive>\n      <li class=\"xxd-list__item\"><span class=\"xxd-thumbs\"><img src=\"/demo/poster-1.svg\" alt=\"\"><img src=\"/demo/poster-2.svg\" alt=\"\"><img src=\"/demo/poster-3.svg\" alt=\"\"></span><div class=\"xxd-list__main\"><div class=\"xxd-list__title\">24 张图片</div><div class=\"xxd-list__meta\">渐变 · 14:02</div></div><button class=\"xxd-btn xxd-reveal\" data-variant=\"ghost\" data-size=\"xs\" data-confirm-twice=\"确认删除\">删除</button><button class=\"xxd-btn\" data-size=\"xs\">打开</button></li>\n      <li class=\"xxd-list__item\"><span class=\"xxd-thumbs\"><img src=\"/demo/poster-4.svg\" alt=\"\"><img src=\"/demo/poster-5.svg\" alt=\"\"></span><div class=\"xxd-list__main\"><div class=\"xxd-list__title\">8 张图片</div><div class=\"xxd-list__meta\">原样 · 09:40</div></div><button class=\"xxd-btn xxd-reveal\" data-variant=\"ghost\" data-size=\"xs\" data-confirm-twice=\"确认删除\">删除</button><button class=\"xxd-btn\" data-size=\"xs\">打开</button></li>\n    </ul></section>\n  <section><h3 class=\"xxd-history__day\">昨天</h3>\n    <ul class=\"xxd-list xxd-group__body\" data-interactive>\n      <li class=\"xxd-list__item\"><span class=\"xxd-thumbs\"><img src=\"/demo/poster-6.svg\" alt=\"\"></span><div class=\"xxd-list__main\"><div class=\"xxd-list__title\">一篇关于设计系统的长文</div><div class=\"xxd-list__meta\">已写入 X · 21:15</div></div><button class=\"xxd-btn xxd-reveal\" data-variant=\"ghost\" data-size=\"xs\" data-confirm-twice=\"确认删除\">删除</button><button class=\"xxd-btn\" data-size=\"xs\">打开</button></li>\n    </ul></section>\n  <button class=\"xxd-link\" data-confirm-twice=\"确认清空全部记录\" data-tone=\"danger\">清空全部记录</button>\n</div>",
      "rules": [
        "最多 50 行；同一组再做一次只更新那一行",
        "删除点两次（不弹对话框）"
      ]
    },
    {
      "name": "ConfirmTwice",
      "slug": "confirm-twice",
      "zh": "两次确认",
      "from": "图片排序",
      "summary": "可撤销性低但不严重的删除：第一次点按钮变成「确认删除」（危险色），3 秒内再点才执行；不弹对话框。",
      "classes": [],
      "markup": "<button class=\"xxd-btn\" data-confirm-twice=\"确认删除\" id=\"twice-demo\">删除这一组</button>\n<script>document.getElementById(\"twice-demo\").addEventListener(\"xxd:confirm\", () => Xxd.toast(\"已删除\", { tone: \"success\" }));</script>",
      "rules": [
        "3 秒没再点就恢复原样",
        "真正不可恢复、影响大的，用「输入名字确认删除」（Dialog）"
      ],
      "js": "button.addEventListener(\"xxd:confirm\", () => remove())"
    },
    {
      "name": "SignIn",
      "slug": "sign-in",
      "zh": "登录",
      "from": "各插件",
      "summary": "没登录时侧边栏只有这一屏：标志、名字、一句话、新账号福利、Google 继续、或用邮箱（两步：邮箱 → 密码）、条款。",
      "classes": [
        "xxd-auth",
        "xxd-auth__name",
        "xxd-auth__line",
        "xxd-auth__gift",
        "xxd-auth__or",
        "xxd-auth__terms"
      ],
      "markup": "<div class=\"xxd-auth xxd-frame\" data-xxd-auth>\n  <span class=\"xxd-logo\" data-size=\"lg\"><span class=\"xxd-logo__mark\"></span></span>\n  <h2 class=\"xxd-auth__name\">小小东 · 长文发布</h2>\n  <p class=\"xxd-auth__line\">把 Markdown 写进 X 文章，排版、图片一起带过去。</p>\n  <span class=\"xxd-auth__gift\">新账号送 7 天完整体验</span>\n  <form>\n    <button class=\"xxd-btn\" data-block type=\"button\"><svg class=\"ui-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\"><path fill=\"#FFC107\" d=\"M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z\"/><path fill=\"#FF3D00\" d=\"m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z\"/><path fill=\"#4CAF50\" d=\"M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z\"/><path fill=\"#1976D2\" d=\"M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z\"/></svg>使用 Google 继续</button>\n    <div class=\"xxd-auth__or\">或使用邮箱</div>\n    <div data-step=\"email\" data-active>\n      <input class=\"xxd-input\" type=\"email\" placeholder=\"you@example.com\" aria-label=\"邮箱\" required>\n      <button class=\"xxd-btn\" data-variant=\"primary\" data-block data-auth-next=\"password\">继续</button>\n    </div>\n    <div data-step=\"password\">\n      <p class=\"xxd-help\">登录 <b data-auth-email></b></p>\n      <input class=\"xxd-input\" type=\"password\" placeholder=\"密码\" aria-label=\"密码\">\n      <div class=\"xxd-cluster\"><button class=\"xxd-btn ui-dialog-cancel\" data-auth-back=\"email\">返回</button><button class=\"xxd-btn\" data-variant=\"primary\" style=\"flex:1\">继续</button></div>\n      <button class=\"xxd-link\" type=\"button\" style=\"justify-self:start\">忘记密码？</button>\n    </div>\n  </form>\n  <p class=\"xxd-auth__terms\">继续即表示同意 <a class=\"xxd-link\" href=\"#\">服务条款</a> 和 <a class=\"xxd-link\" href=\"#\">隐私政策</a></p>\n</div>",
      "rules": [
        "<html data-account> 在首帧前就设好（不闪登录页）",
        "「继续」一直在；邮箱格式不对时在输入框下面说清楚怎么改（Xxd.setFieldError），焦点回到输入框",
        "会话过期回到这里时，要说一句为什么"
      ]
    },
    {
      "name": "Membership",
      "slug": "membership",
      "zh": "会员计划与购买",
      "from": "长文发布、图片排序",
      "summary": "账号卡上一行计划；「开通会员 / 续费」在原地展开购买面板：选计划 · 选支付方式 · 二维码 · 「我已支付，立即查询」。每种结果一句话。",
      "classes": [
        "xxd-account",
        "xxd-account__main",
        "xxd-account__name",
        "xxd-plan-line",
        "xxd-plans",
        "xxd-plan",
        "xxd-plan__name",
        "xxd-plan__price",
        "xxd-qr",
        "xxd-qr__code"
      ],
      "markup": "<div class=\"xxd-stack\" style=\"max-width:380px\">\n  <div class=\"xxd-group__body\"><div class=\"xxd-account\"><span class=\"xxd-avatar\" data-member style=\"--avatar-size:36px\">东</span><div class=\"xxd-account__main\"><div class=\"xxd-account__name\">小小东</div><div class=\"xxd-plan-line\" data-tone=\"member\" id=\"plan-line\">完整体验 · 还剩 6 天</div></div><button class=\"xxd-btn\" data-size=\"sm\" data-variant=\"primary\" id=\"buy\">开通会员</button></div></div>\n  <div class=\"xxd-plans\" role=\"radiogroup\" aria-label=\"计划\">\n    <label class=\"xxd-plan\"><input type=\"radio\" class=\"xxd-radio\" name=\"plan\" checked><span class=\"xxd-plan__name\">月度会员<small>每月自动提醒续费</small></span><span class=\"xxd-plan__price\">¥29</span></label>\n    <label class=\"xxd-plan\"><input type=\"radio\" class=\"xxd-radio\" name=\"plan\"><span class=\"xxd-plan__name\">年度会员<small>相当于每月 ¥19</small></span><span class=\"xxd-plan__price\">¥228</span></label>\n  </div>\n  <p class=\"xxd-help\">体验剩下的天数会保留；续费从当前到期日往后算。</p>\n  <div class=\"xxd-segmented\" data-xxd-segmented data-block aria-label=\"支付方式\"><button role=\"radio\" aria-checked=\"true\">微信</button><button role=\"radio\">支付宝</button><button role=\"radio\">银行卡</button></div>\n  <div class=\"xxd-qr\"><svg class=\"xxd-qr__code\" viewBox=\"-2 -2 37 37\" role=\"img\" aria-label=\"付款二维码\" shape-rendering=\"crispEdges\"><path fill=\"#111\" d=\"M0 0h7v1h-7zM9 0h1v1h-1zM12 0h3v1h-3zM16 0h5v1h-5zM23 0h1v1h-1zM26 0h7v1h-7zM0 1h1v1h-1zM6 1h1v1h-1zM9 1h1v1h-1zM11 1h1v1h-1zM13 1h5v1h-5zM20 1h2v1h-2zM26 1h1v1h-1zM32 1h1v1h-1zM0 2h1v1h-1zM2 2h3v1h-3zM6 2h1v1h-1zM8 2h1v1h-1zM10 2h1v1h-1zM12 2h2v1h-2zM15 2h1v1h-1zM17 2h6v1h-6zM24 2h1v1h-1zM26 2h1v1h-1zM28 2h3v1h-3zM32 2h1v1h-1zM0 3h1v1h-1zM2 3h3v1h-3zM6 3h1v1h-1zM8 3h1v1h-1zM11 3h1v1h-1zM14 3h3v1h-3zM19 3h2v1h-2zM22 3h3v1h-3zM26 3h1v1h-1zM28 3h3v1h-3zM32 3h1v1h-1zM0 4h1v1h-1zM2 4h3v1h-3zM6 4h1v1h-1zM8 4h1v1h-1zM10 4h3v1h-3zM15 4h1v1h-1zM17 4h2v1h-2zM21 4h3v1h-3zM26 4h1v1h-1zM28 4h3v1h-3zM