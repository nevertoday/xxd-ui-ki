---
import Site from "../../layouts/Site.astro";
// D1：平面（缺省）和立体（data-finish="material"）并排看，再决定插件里默认哪一种。
const sets = [
  { finish: "flat", name: "平面", note: "缺省。实心按钮就是一块颜色，边和底同色。" },
  { finish: "material", name: "立体", note: "实心按钮顶部 1px 内高光、边深一点、按下沉 0.5px。没有外阴影 —— 是材质，不是浮起。" },
];
const sample = `<div class="xxd-cluster"><button class="xxd-btn" data-variant="primary">写入 X</button><button class="xxd-btn">保存草稿</button><button class="xxd-btn" data-variant="danger">删除</button><button class="xxd-btn" data-variant="ghost">取消</button></div>
<div class="xxd-cluster"><button class="xxd-btn" data-variant="primary" data-size="sm">复制 24 个链接</button><button class="xxd-btn" data-variant="primary" data-size="lg">开通会员</button></div>
<footer class="xxd-dock" style="position:static;border:1px solid var(--line)"><div class="xxd-dock__status">24 张 · 来自 mp.weixin.qq.com</div><div class="xxd-dock__primary"><button class="xxd-btn" data-variant="primary" data-size="sm">复制链接</button></div></footer>`;
---

<Site title="质感" headings={[{ slug: "compare", text: "并排" }, { slug: "use", text: "怎么开" }]}>
  <header class="site-head">
    <p class="xxd-text" data-variant="caption">基础</p>
    <h1 class="xxd-text" data-variant="display">质感：平面 / 立体</h1>
    <p class="site-lead">只影响实心按钮（主操作、危险）。两种都在当前主题、圆角、主色下渲染 —— 用顶栏切换外观对比。</p>
  </header>
  <h2 class="site-h2" id="compare">并排</h2>
  <div class="site-dodont">
    {sets.map((s) => (
      <figure data-kind="do">
        <div class="site-dodont__stage" data-finish={s.finish} style="display:grid;gap:14px;justify-items:start" set:html={sample} />
        <figcaption><b>{s.name}</b>{s.note}</figcaption>
      </figure>
    ))}
  </div>
  <h2 class="site-h2" id="use">怎么开</h2>
  <pre class="xxd-code" tabindex="0"><code>{`<html data-finish="material">          <!-- 整个产品 -->
<section data-finish="material">…</section>  <!-- 局部；里面再写 data-finish="flat" 可以关掉 -->
Xxd.mountAppearance(el, { showFinish: true })   // 让用户在「外观」里选`}</code></pre>
</Site>
