---
// 每个组件一页（从 packages/xxd-css/registry.json 生成，英文叠上 registry.en.js）。
// 固定结构：演示 · 状态 · 属性 · JS · 规则 · 相关。中文 / 英文共用，c 由页面的 getStaticPaths 传进来。
import Site from "../layouts/Site.astro";
import Demo from "../components/Demo.astro";
import StateMatrix from "../components/StateMatrix.astro";
import PropsTable from "../components/PropsTable.astro";
import ReactProps from "../components/ReactProps.astro";
import kumoRegistry from "@cloudflare/kumo/ai/component-registry.json";
import xxdReactProps from "@xxd/react/props.json";
import { componentsFor } from "../lib/data.js";
import { langOf, t, withLang } from "../i18n/index.js";
import { richText } from "../lib/markup.js";
import { principlesFor } from "../data/principles.js";
import * as reactDemos from "../react/demos.tsx";
import { WALL, WALL_PREVIEW } from "../data/wall.js";
import { WALL as WALL_EN } from "../data/wall.en.js";
import { miniOfWeb } from "../lib/mini.js";

const { c } = Astro.props;
const lang = langOf(Astro.url.pathname);
const L = t(lang);
const hasReact = `${c.name}Demo` in reactDemos;
// 小程序版（@xxd/mini）里对应的组件：演示多一个「小程序」标签页
const mini = miniOfWeb(c.name, lang);
// React 组件名：registry 里写的第一个名字（「Dialog + DialogActions（@xxd/react）」→ Dialog）
const reactName = c.react?.match(/^[A-Z]\w+/)?.[0];
const hasReactProps = Boolean(reactName && (kumoRegistry.components[reactName] || xxdReactProps[reactName]));
const related = componentsFor(lang).filter((x) => x.category === c.category && x.slug !== c.slug);
const extraDemos = c.examples ?? [];
const headings = [
  ...(c.use?.length || c.avoid?.length ? [{ slug: "use", text: L.use }] : []),
  { slug: "demo", text: L.demo },
  ...extraDemos.map((e, i) => ({ slug: `example-${i}`, text: e.title, depth: 3 })),
  ...(c.sample && c.states ? [{ slug: "states", text: L.states }] : []),
  { slug: "props", text: L.props },
  ...(hasReactProps ? [{ slug: "react-props", text: L.reactProps }] : []),
  ...(c.js ? [{ slug: "js", text: "JS" }] : []),
  ...(c.a11y ? [{ slug: "a11y", text: L.a11y }] : []),
  ...(c.rules?.length ? [{ slug: "rules", text: L.rules }] : []),
  ...(related.length ? [{ slug: "related", text: L.related }] : []),
];
const title = lang === "en" ? c.label : `${c.label} ${c.name}`;
// 规则里单独一条「§9」：指向设计原则的那一节（同一个 § 有几条时，链到第一条）
const principleOf = (ref) => principlesFor(lang).find((p) => p.ref === ref);
const ruleHtml = (r) => {
  const p = /^§[\d½]+$/.test(r) ? principleOf(r) : null;
  if (!p) return richText(r);
  const label = lang === "en" ? `See design principle ${r}: ${p.title}` : `见设计原则 ${r}：${p.title}`;
  return `<a class="xxd-link" href="${withLang(`/principles#${p.id}`, lang)}">${label.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</a>`;
};
const description = c.summary ?? (lang === "en" ? `${c.label} — an XXD UI component` : `${c.label}（${c.name}）—— 小小东 UI 组件`);
---

<Site title={title} description={description} headings={headings} charts={c.name === "Chart"}>
  <header class="site-head">
    <p class="xxd-text" data-variant="caption">{L.componentCaption} · {c.categoryLabel}{hasReact && ` · ${L.bothImpl}`}</p>
    <h1 class="xxd-text" data-variant="display">{c.label} {(lang !== "en" || c.label !== c.name) && <span class="xxd-text" data-variant="mono-secondary">{c.name}</span>}</h1>
    {c.summary && <p class="site-lead" set:html={richText(c.summary)} />}
    <p class="site-names">
      <span>{L.classLine} <code class="xxd-code-inline">{c.classes[0]}</code></span>
      {c.react && <span>React <code class="xxd-code-inline">{`<${reactName ?? c.react}>`}</code></span>}
      {mini && <span><a class="xxd-link" href={withLang(`/miniprogram/${mini.slug}`, lang)}>{L.miniTab}</a> <code class="xxd-code-inline">{`<${mini.name}>`}</code></span>}
    </p>
  </header>

  {
    (c.use?.length || c.avoid?.length) && (
      <>
        <h2 class="site-h2" id="use">{L.use}</h2>
        <div class="site-use">
          {c.use?.length > 0 && <ul class="site-rules" data-kind="use">{c.use.map((r) => <li set:html={richText(r)} />)}</ul>}
          {c.avoid?.length > 0 && (
            <>
              <h3 class="site-h3">{L.avoid}</h3>
              <ul class="site-rules" data-kind="avoid">{c.avoid.map((r) => <li set:html={richText(r)} />)}</ul>
            </>
          )}
        </div>
      </>
    )
  }

  <h2 class="site-h2" id="demo">{L.demo}</h2>
  <Demo markup={c.markup} react={hasReact ? c.name : undefined} align={c.align} block={c.block} title={c.name} preview={WALL_PREVIEW.has(c.name) ? (lang === "en" ? WALL_EN : WALL)[c.name] : undefined} mini={mini && { name: mini.name, label: mini.label }} />

  {
    extraDemos.map((e, i) => (
      <>
        <h3 class="site-h3" id={`example-${i}`}>{e.title}</h3>
        {e.text && <p class="site-p" set:html={richText(e.text)} />}
        <Demo markup={e.markup} align={e.align} block={e.block} />
      </>
    ))
  }

  {
    c.sample && c.states && (
      <>
        <h2 class="site-h2" id="states">{L.states}</h2>
        <p class="site-p">{L.statesNote}</p>
        <StateMatrix sample={c.sample} states={c.states} />
      </>
    )
  }

  <h2 class="site-h2" id="props">{L.props}</h2>
  <PropsTable attributes={c.attributes} classes={c.classes} />

  {
    hasReactProps && (
      <>
        <h2 class="site-h2" id="react-props">{L.reactProps}</h2>
        <ReactProps name={reactName} />
      </>
    )
  }

  {
    c.js && (
      <>
        <h2 class="site-h2" id="js">JS</h2>
        <pre class="site-code" tabindex="0" style="border:1px solid var(--line);border-radius:var(--r-md)"><code>{c.js}</code></pre>
      </>
    )
  }

  {
    c.a11y && (
      <>
        <h2 class="site-h2" id="a11y">{L.a11y}</h2>
        <ul class="site-rules">{c.a11y.map((r) => <li set:html={richText(r)} />)}</ul>
      </>
    )
  }

  {
    c.rules?.length > 0 && (
      <>
        <h2 class="site-h2" id="rules">{L.rules}</h2>
        <ul class="site-rules">{c.rules.map((r) => <li set:html={ruleHtml(r)} />)}</ul>
      </>
    )
  }

  {
    related.length > 0 && (
      <>
        <h2 class="site-h2" id="related">{L.related}</h2>
        <div class="xxd-cluster">
          {related.map((r) => (
            <a class="xxd-chip" href={withLang(`/components/${r.slug}`, lang)}>{r.label}</a>
          ))}
        </div>
      </>
    )
  }
</Site>
