{
  "name": "@xxd/react",
  "version": "0.1.0",
  "private": true,
  "description": "小小东 UI 的 React 组件：Kumo 换皮，加小小东独有组件和外观、语言 Provider / XXD UI React components",
  "license": "MIT",
  "author": "小小东 (nevertoday)",
  "homepage": "https://ui.xiaoxiaodong.ai",
  "bugs": {
    "url": "https://github.com/nevertoday/xxd-ui-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nevertoday/xxd-ui-kit.git",
    "directory": "packages/xxd-react"
  },
  "keywords": [
    "react",
    "components",
    "ui-kit",
    "tailwind",
    "xxd-ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./standalone.css": "./standalone.css",
    "./xxd.css": "./xxd.css",
    "./props.json": "./dist/props.json"
  },
  "files": [
    "dist",
    "styles.css",
    "standalone.css",
    "xxd.css",
    "LICENSE-KUMO"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/build.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@xxd/css": "workspace:*",
    "@xxd/icons": "workspace:*",
    "@xxd/tokens": "workspace:*",
    "cn": "0.4.0",
    "react-day-picker": "^9.13.2",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/kumo": "workspace:*",
    "@testing-library/react": "16.3.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "0.28.1",
    "happy-dom": "catalog:",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  }
}
