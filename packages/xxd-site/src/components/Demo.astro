---
// 活演示：上面是真的组件，下面是代码。有 React 版时多一个「React」标签页，两种实现并排。
import { icon } from "../lib/data.js";
import { embed, extractFunction, nextId } from "../lib/markup.js";
import ReactDemo from "../react/ReactDemo.tsx";
import demoSource from "../react/demos.tsx?raw";

interface Props {
  markup: string;
  react?: string;
  align?: "center" | "start";
  block?: boolean;
  title?: string;
}
const { markup, react, align = "center", block = false, title } = Astro.props;
const id = nextId("demo");
const reactCode = react ? extractFunction(demoSource, `${react}Demo`) : "";
const hasReact = Boolean(reactCode);
---

<div class="site-demo" data-demo={title}>
  <div id={`${id}-native`}>
    <div class="site-demo__stage" data-align={align} data-block={block ? "" : undefined} set:html={embed(markup)} />
  </div>
  {
    hasReact && (
      <div id={`${id}-react`} hidden>
        <div class="site-demo__stage" data-align={align} data-block={block ? "" : undefined}>
          <ReactDemo client:visible name={react} />
        </div>
      </div>
    )
  }
  <div class="site-demo__bar">
    <div class="xxd-tabs" data-xxd-tabs data-size="sm" aria-label="实现">
      <button role="tab" id={`${id}-t1`} aria-controls={`${id}-native ${id}-code1`} aria-selected="true">原生 HTML</button>
      {hasReact && <button role="tab" id={`${id}-t2`} aria-controls={`${id}-react ${id}-code2`}>React</button>}
    </div>
    <button class="xxd-btn" data-variant="ghost" data-size="sm" data-site-code-toggle aria-expanded="false">
      <Fragment set:html={icon("Code", 14)} />代码
    </button>
  </div>
  <pre class="site-code" tabindex="0" id={`${id}-code1`} hidden><code>{markup.trim()}</code><button class="xxd-btn" data-variant="ghost" data-icon-only data-size="sm" aria-label="复制" data-copy-target={`#${id}-code1 code`} set:html={icon("Copy", 14)} /></pre>
  {hasReact && <pre class="site-code" tabindex="0" id={`${id}-code2`} hidden><code>{reactCode}</code><button class="xxd-btn" data-variant="ghost" data-icon-only data-size="sm" aria-label="复制" data-copy-target={`#${id}-code2 code`} set:html={icon("Copy", 14)} /></pre>}
</div>

<script is:inline>
  // 「代码」按钮：展开 / 收起当前标签页对应的代码；切换标签页时代码跟着换
  (() => {
    for (const demo of document.querySelectorAll(".site-demo:not([data-ready])")) {
      demo.setAttribute("data-ready", "");
      const toggle = demo.querySelector("[data-site-code-toggle]");
      const codes = [...demo.querySelectorAll(".site-code")];
      const tabs = [...demo.querySelectorAll('.site-demo__bar > .xxd-tabs > [role="tab"]')];
      const show = () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        const i = Math.max(0, tabs.findIndex((t) => t.getAttribute("aria-selected") === "true"));
        codes.forEach((c, n) => (c.hidden = !(open && n === i)));
        // 标签页的 aria-controls 写了两个 id：舞台交给 tabs 脚本，代码由这里管
        tabs.forEach((t, n) => {
          const stage = document.getElementById(t.getAttribute("aria-controls").split(" ")[0]);
          if (stage) stage.hidden = n !== i;
        });
      };
      toggle.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true"));
        show();
      });
      demo.addEventListener("xxd:change", show);
    }
  })();
</script>
