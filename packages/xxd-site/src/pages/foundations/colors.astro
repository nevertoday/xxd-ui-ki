---
import Site from "../../layouts/Site.astro";
import { tokens, ACCENT_PRESETS, accentPalette, contrast, toRgb } from "../../lib/data.js";
const surfaces = ["--bg", "--paper", "--wash", "--wash-strong", "--selected-bg", "--line", "--line-strong"];
const inks = ["--ink", "--muted", "--muted-2", "--on-ink"];
const meaning = ["--success", "--danger", "--warning", "--success-strong", "--danger-strong", "--warning-strong"];
const dark = { ...tokens.base, ...tokens.dark };
const ratio = (fg, bg) => contrast(toRgb(fg), toRgb(bg)).toFixed(2);
const accents = ACCENT_PRESETS.slice(1).map((p) => {
  const pal = accentPalette(p.id);
  return { ...p, light: pal["--action-custom"], text: pal["--action-text-custom"], darkMark: pal["--action-custom-dark"], darkText: pal["--action-text-custom-dark"],
    lr: ratio(pal["--action-text-custom"], "#ffffff"), dr: ratio(pal["--action-text-custom-dark"], "#201f1a") };
});
const headings = [{ slug: "surfaces", text: "纸与线" }, { slug: "ink", text: "墨与文字" }, { slug: "meaning", text: "语义色" }, { slug: "accent", text: "18 个主色" }];
const swatch = (name) => ({ name, light: tokens.base[name], dark: dark[name] });
---

<Site title="颜色" headings={headings}>
  <header class="site-head">
    <p class="xxd-text" data-variant="caption">基础</p>
    <h1 class="xxd-text" data-variant="display">颜色</h1>
    <p class="site-lead">黑 / 白 / 灰，强调靠墨色；颜色只留给意义和可选的主色。色块显示当前外观下的颜色，下面写着亮 / 暗两套值。</p>
  </header>
  {[["surfaces", "纸与线", surfaces], ["ink", "墨与文字", inks], ["meaning", "语义色", meaning]].map(([id, title, names]) => (
    <section>
      <h2 class="site-h2" id={id}>{title}</h2>
      <div class="site-swatches">
        {names.map((n) => { const s = swatch(n); return (
          <div class="site-swatch"><i style={`background:var(${n})`}></i><div><b class="xxd-text" data-variant="mono" style="font-size:11px">{n}</b><code>亮 {s.light}</code><code>暗 {s.dark}</code></div></div>
        ); })}
      </div>
    </section>
  ))}
  <p class="site-p" style="margin-top:var(--space-4)">对比度（测试门禁）：正文与次要文字在 paper / bg / wash 上 ≥ 4.5；语义色 ≥ 4.5；*-strong 做底时白字 ≥ 4.5。</p>

  <h2 class="site-h2" id="accent">18 个主色</h2>
  <p class="site-p">主色会被自动提亮或加深：标记 ≥ 3:1、文字 ≥ 4.5:1，亮暗两种纸上都成立。第一个是墨色，也是默认。</p>
  <div class="xxd-table-wrap"><table class="site-props">
    <thead><tr><th>主色</th><th>亮 · 标记</th><th>亮 · 文字（对比度）</th><th>暗 · 标记</th><th>暗 · 文字（对比度）</th></tr></thead>
    <tbody>
      {accents.map((a) => (
        <tr>
          <td><span class="xxd-dot" style={`background:${a.id};width:10px;height:10px`}></span> {a.zh} <span class="xxd-text" data-variant="mono-secondary">{a.id}</span></td>
          <td><span class="xxd-dot" style={`background:${a.light}`}></span> {a.light}</td>
          <td style={`color:${a.text}`}>{a.text} · {a.lr}</td>
          <td><span class="xxd-dot" style={`background:${a.darkMark}`}></span> {a.darkMark}</td>
          <td><span style={`background:#201f1a;color:${a.darkText};padding:1px 6px`}>{a.darkText} · {a.dr}</span></td>
        </tr>
      ))}
    </tbody>
  </table></div>
</Site>
