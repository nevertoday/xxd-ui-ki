---
interface Props {
  doMarkup: string;
  dontMarkup: string;
  doText: string;
  dontText: string;
}
const { doMarkup, dontMarkup, doText, dontText } = Astro.props;
---

<div class="site-dodont">
  <figure data-kind="do">
    <div class="site-dodont__stage" set:html={doMarkup} />
    <figcaption><b>好</b>{doText}</figcaption>
  </figure>
  <figure data-kind="dont">
    <div class="site-dodont__stage" set:html={dontMarkup} />
    <figcaption><b>不好</b>{dontText}</figcaption>
  </figure>
</div>
