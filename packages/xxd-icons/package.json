{
  "name": "@xxd/icons",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "小小东图标：24 网格、1.5 线宽、圆头、斜接角、方角。SVG 字符串（原生 JS）+ React 组件 + Phosphor 兼容层。",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/svg.d.ts",
      "import": "./src/svg.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    },
    "./phosphor": {
      "types": "./src/phosphor.d.ts",
      "import": "./src/phosphor.js"
    },
    "./nodes": "./src/nodes.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test 'test/*.test.mjs'"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "react": "19.2.0",
    "@types/react": "catalog:"
  }
}
