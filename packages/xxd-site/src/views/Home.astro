---
// 首页：组件墙。每格一个真的组件（能点、能切外观），点名字进组件页。中文 / 英文共用。
import Site from "../layouts/Site.astro";
import { componentsFor } from "../lib/data.js";
import { embed } from "../lib/markup.js";
import { langOf, t, withLang } from "../i18n/index.js";
import { WALL, WALL_HIDE, WALL_WIDE } from "../data/wall.js";
import { WALL as WALL_EN } from "../data/wall.en.js";
const lang = langOf(Astro.url.pathname);
const L = t(lang);
const T = {
  zh: {
    lead: "中文优先、不依赖框架的界面组件：一个 CSS 加一个 JS 就能用，专门照顾 Chrome 插件。黑白灰、默认直角、强调靠墨色；右上角切换主题、圆角、主色、密度和按钮质感，下面每一格都跟着变。",
    start: "开始使用",
    principles: "设计原则",
    cli: "命令行",
    wall: "全部组件",
  },
  en: {
    lead: "A Chinese-first, framework-free UI kit — one CSS file and one JS file, built with Chrome extensions in mind. Black, white and gray, square corners by default, ink for emphasis. Switch the theme, corners, accent, density and button style in the top right — every cell below follows.",
    start: "Get started",
    principles: "Design principles",
    cli: "CLI",
    wall: "All components",
  },
}[lang];
const staticForms = lang === "en" ? WALL_EN : WALL;
// 墙上的格子一样高：示例里写死的高度（侧栏 420px）缩到格子放得下
const fitWall = (markup) => markup.replace(/height:\s*4\d\dpx/g, "height:230px");
const wall = componentsFor(lang).filter((c) => c.wall !== false && !WALL_HIDE.has(c.name));
---

<Site title={L.brand} wide charts>
  <header class="site-head" style="max-width:760px">
    <h1 class="xxd-text" data-variant="display">{L.brand}</h1>
    <p class="site-lead">{T.lead}</p>
    <div class="xxd-cluster" style="margin-top:var(--space-5)">
      <a class="xxd-btn" data-variant="primary" href={withLang("/start", lang)}>{T.start}</a>
      <a class="xxd-btn" href={withLang("/principles", lang)}>{T.principles}</a>
      <a class="xxd-btn" data-variant="ghost" href={withLang("/tools", lang)}>{T.cli}</a>
    </div>
  </header>
  <section class="site-wall" aria-label={T.wall}>
    {
      wall.map((c) => (
        <div class="site-wall__cell" data-wide={WALL_WIDE.has(c.name) ? "" : undefined}>
          <a class="site-wall__name" href={withLang(`/components/${c.slug}`, lang)}>
            {c.label}
            {lang !== "en" && <span>{c.name}</span>}
          </a>
          <div class="site-wall__stage xxd-page" data-block={c.block && !staticForms[c.name] ? "" : undefined} set:html={embed(staticForms[c.name] ?? c.wall ?? fitWall(c.markup))} />
        </div>
      ))
    }
  </section>
</Site>
