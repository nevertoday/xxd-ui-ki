---
import Site from "../../layouts/Site.astro";
const speeds = [["--motion-quick", "140ms", "状态变化：离开 hover、颜色、淡入淡出、完成的勾"], ["--motion-panel", "180ms", "右侧面板滑入"], ["--motion-sheet", "200ms", "sheet 从 dock 升起（ease-out-expo）"], ["--motion-medium", "220ms", "小型进入：行、筛选、进度、开关滑块"], ["--motion-sheet-out", "120ms", "sheet 收回"]];
---

<Site title="动效" headings={[{ slug: "speeds", text: "四档速度" }, { slug: "rules", text: "规则" }]}>
  <header class="site-head">
    <p class="xxd-text" data-variant="caption">基础</p>
    <h1 class="xxd-text" data-variant="display">动效</h1>
    <p class="site-lead">动效用来揭示层级和给反馈，不是装饰。只动 opacity 和 transform；不弹跳；减少动效时一次性全部静止。点「播放」看每一档。</p>
  </header>
  <h2 class="site-h2" id="speeds">速度</h2>
  <div class="xxd-group__body">
    {speeds.map(([k, v, use]) => (
      <div class="xxd-row">
        <div class="xxd-row__text"><div class="xxd-row__title xxd-text" data-variant="mono">{k} · {v}</div><div class="xxd-row__desc">{use}</div></div>
        <div class="xxd-row__control" style="width:220px"><span class="site-motion-dot" data-motion={k} style={`display:block;width:16px;height:16px;background:var(--action);transition:transform var(${k}) var(--ease-out-expo)`}></span></div>
        <div class="xxd-row__control"><button class="xxd-btn" data-size="sm" data-play={k}>播放</button></div>
      </div>
    ))}
  </div>
  <h2 class="site-h2" id="rules">规则</h2>
  <ul class="site-rules">
    <li>hover：进入立即变，离开 140ms 淡回。</li>
    <li>菜单、popover、tooltip 从锚点方向 0.96 → 1 长出来；对话框和 sheet 升起。</li>
    <li>tooltip 关掉后 300ms 内移到下一个按钮，立即出现、原地换字。</li>
    <li>折叠只淡入 + 小位移，不做高度动画。</li>
    <li>进行中的按钮宽度不跳；完成后图标变勾 1 秒。</li>
  </ul>
  <script is:inline>
    for (const b of document.querySelectorAll("[data-play]")) {
      b.addEventListener("click", () => {
        const dot = document.querySelector(`[data-motion="${b.dataset.play}"]`);
        dot.style.transform = dot.style.transform ? "" : "translateX(200px)";
      });
    }
  </script>
</Site>
